{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moemail",
  "compatibility_date": "2024-03-20",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".vercel/output/static",
